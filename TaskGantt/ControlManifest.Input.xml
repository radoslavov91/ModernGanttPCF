<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Voss" constructor="TaskGantt" version="3.0.0" display-name-key="Task Gantt" description-key="Responsive Gantt view for Dataverse tasks" control-type="virtual">
    <data-set name="tasks" display-name-key="Tasks" cds-data-set-options="displayCommandBar:false;displayViewSelector:false;displayQuickFind:false">
      <property-set name="subject" display-name-key="Task name" description-key="Task subject" of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="scheduledend" display-name-key="Due Date" description-key="Scheduled end" of-type="DateAndTime.DateAndTime" usage="bound" required="true" />
      <property-set name="ownerid" display-name-key="Assigned to" description-key="Task owner" of-type="Lookup.Owner" usage="bound" required="true" />
      <property-set name="statecode" display-name-key="Status" description-key="Task status" of-type="OptionSet" usage="bound" required="true" />
      <property-set name="scheduledstart" display-name-key="Start Date" description-key="Scheduled start" of-type="DateAndTime.DateAndTime" usage="bound" required="true" />
      <property-set name="createdon" display-name-key="Created On" description-key="Created on" of-type="DateAndTime.DateAndTime" usage="bound" required="true" />
    </data-set>
    <resources>
      <code path="index.ts" order="1" />
      <platform-library name="React" version="16.14.0" />
      <css path="css/TaskGantt.css" order="1" />
      <resx path="strings/TaskGantt.1033.resx" version="1.0.0" />
    </resources>
    <feature-usage><uses-feature name="Utility" required="true" /></feature-usage>
  </control>
</manifest>
